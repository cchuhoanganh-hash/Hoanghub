local ESP_Objects = {}
local function createESP(player)
    if player == LocalPlayer or ESP_Objects[player] then return end
    local playerCircle = Drawing.new("Circle") playerCircle.Visible = false playerCircle.Thickness = 1.5 playerCircle.NumSides = 14 playerCircle.Radius = 15 playerCircle.Filled = false playerCircle.Transparency = 0.7 playerCircle.Color = Color_NoTarget
    local bgBar = Drawing.new("Square") bgBar.Visible = false bgBar.Filled = true bgBar.Thickness = 1 bgBar.Color = Color3.fromRGB(0, 0, 0) bgBar.Transparency = 0.5
    local mainBar = Drawing.new("Square") mainBar.Visible = false mainBar.Filled = true mainBar.Thickness = 1 mainBar.Color = Color_Health
    local distText = Drawing.new("Text") distText.Visible = false distText.Size = 12 distText.Center = true distText.Outline = true distText.Color = Color3.fromRGB(255, 255, 255)
    ESP_Objects[player] = {PlayerCircle = playerCircle, BackgroundBar = bgBar, MainBar = mainBar, DistanceText = distText}
end

local function removeESP(player)
    if ESP_Objects[player] then
        pcall(function() ESP_Objects[player].PlayerCircle:Remove() ESP_Objects[player].BackgroundBar:Remove() ESP_Objects[player].MainBar:Remove() ESP_Objects[player].DistanceText:Remove() end)
        ESP_Objects[player] = nil
    end
end
