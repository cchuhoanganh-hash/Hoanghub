------------------------------------------------------------------------
-- THUẬT TOÁN TỐI ƯU HÓA: CHỈ RAYCAST KẺ ĐỊCH GẦN NHẤT
------------------------------------------------------------------------
local function isVisible(part, character)
    if not WallCheckEnabled then return true end
    local origin = Camera.CFrame.Position
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, character}
    return workspace:Raycast(origin, part.Position - origin, raycastParams) == nil
end

local function getClosestPlayerInFOV()
    if not Camera then return nil end
    local bestTarget = nil
    local shortestDistance = FOV_Hitbox_Radius
    local screenCenter = Vector2.new(Camera.ViewportSize.X * 0.5, (Camera.ViewportSize.Y * 0.5) + FOV_Y_Offset)
    
    -- TỐI ƯU 1: Tìm ra duy nhất 1 kẻ địch gần tâm ngắm nhất (Chưa xử lý Raycast nặng)
    for player, _ in pairs(ESP_Objects) do
        if player.Character then
            local targetPart = player.Character:FindFirstChild("Head") 
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            
            if targetPart and humanoid and humanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        bestTarget = {part = targetPart, char = player.Character}
                    end
                end
            end
        end
    end
    
    -- TỐI ƯU 2: Chỉ bắn tia Raycast kiểm tra đúng 1 kẻ địch này (Tiết kiệm cực lớn tài nguyên)
    if bestTarget and isVisible(bestTarget.part, bestTarget.char) then
        if TargetModeLegit then
            return bestTarget.char:FindFirstChild(TARGET_PARTS[math.random(1, 3)]) or bestTarget.part
        end
        return bestTarget.part
    end
    return nil
end

------------------------------------------------------------------------
-- SILENT AIM ĐƯỢC CẤU TRÚC LẠI ĐỂ MAX FPS
------------------------------------------------------------------------
local gmt = getrawmetatable(game)
setreadonly(gmt, false)
local oldNamecall = gmt.__namecall local oldIndex = gmt.__index

local function shouldHit()
    if not SilentAim_Enabled then return false end
    return math.random(1, 100) <= HitChance
end

gmt.__index = newcclosure(function(self, index)
    if self == Mouse and (index == "Hit" or index == "Target") then
        if ClosestTarget and ClosestTarget.Parent and shouldHit() then 
            return index == "Hit" and ClosestTarget.CFrame or ClosestTarget 
        end
    end
    return oldIndex(self, index)
end)

gmt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod() 
    -- TỐI ƯU 3: Kiểm tra ClosestTarget trước để tránh unpack args lãng phí tài nguyên
    if ClosestTarget and ClosestTarget.Parent and SilentAim_Enabled and shouldHit() then
        local args = {...}
        if method == "Raycast" and self == workspace then
            args[2] = (ClosestTarget.Position - args[1]).Unit * 1000
            return oldNamecall(self, unpack(args))
        elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
            args[1] = Ray.new(args[1].Origin, (ClosestTarget.Position - args[1].Origin).Unit * 1000)
            return oldNamecall(self, unpack(args))
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(gmt, true)

------------------------------------------------------------------------
-- VÒNG LẶP CHÍNH SIÊU NHẸ
------------------------------------------------------------------------
local renderConnection = nil
local function startRenderLoop()
    if renderConnection then renderConnection:Disconnect() end
    renderConnection = RunService.RenderStepped:Connect(function()
        Camera = workspace.CurrentCamera or workspace:FindFirstChildOfClass("Camera")
        if not LocalPlayer or not Camera then return end
        
        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        
        FOVFrame.Position = UDim2.new(0, Camera.ViewportSize.X * 0.5, 0, (Camera.ViewportSize.Y * 0.5) + FOV_Y_Offset)
        
        if SilentAim_Enabled then
            ClosestTarget = getClosestPlayerInFOV()
            UIStrokeFOV.Color = ClosestTarget and Color_HasTarget or Color_NoTarget
        else
            ClosestTarget = nil
            UIStrokeFOV.Color = Color_NoTarget
        end
        
        local closestEnemyDistance = math.huge 
        
        for player, obj in pairs(ESP_Objects) do
            local hasValidTarget = false
            if player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                
                if hrp and humanoid and humanoid.Health > 0 then
                    hasValidTarget = true
                    local distanceInStuds = 0
                    if myHrp then
                        distanceInStuds = math.round((myHrp.Position - hrp.Position).Magnitude)
                        if distanceInStuds < closestEnemyDistance then closestEnemyDistance = distanceInStuds end
                    end
                    
                    local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    
                    if onScreen and ESP_Enabled then
                        local isTargeted = ClosestTarget and ClosestTarget.Parent == player.Character
                        obj.PlayerCircle.Position = Vector2.new(screenPos.X, screenPos.Y)
                        obj.PlayerCircle.Color = isTargeted and Color_HasTarget or Color_NoTarget
                        obj.PlayerCircle.Radius = math.clamp(3000 / (Camera.CFrame.Position - hrp.Position).Magnitude, 5, 18)
                        
                        local barWidth, barHeight = 28, 3
                        local barX = screenPos.X - (barWidth * 0.5)
                        local barY = screenPos.Y - obj.PlayerCircle.Radius - 7
                        
                        obj.BackgroundBar.Size = Vector2.new(barWidth, barHeight)
                        obj.BackgroundBar.Position = Vector2.new(barX, barY)
                        obj.MainBar.Size = Vector2.new(barWidth * (humanoid.Health / humanoid.MaxHealth), barHeight)
                        obj.MainBar.Position = Vector2.new(barX, barY)
                        obj.MainBar.Color = isTargeted and Color_HasTarget or Color_Health
                        
                        if myHrp then
                            obj.DistanceText.Position = Vector2.new(screenPos.X, barY - 14)
                            obj.DistanceText.Text = "[" .. distanceInStuds .. " studs]"
                            obj.DistanceText.Visible = true
                        end
                        obj.PlayerCircle.Visible, obj.BackgroundBar.Visible, obj.MainBar.Visible = true, true, true
                    else
                        obj.PlayerCircle.Visible, obj.BackgroundBar.Visible, obj.MainBar.Visible, obj.DistanceText.Visible = false, false, false, false
                    end
                end
            end
            if not hasValidTarget then
                obj.PlayerCircle.Visible, obj.BackgroundBar.Visible, obj.MainBar.Visible, obj.DistanceText.Visible = false, false, false, false
            end
        end
        
        if closestEnemyDistance <= 200 then
            WarningLabel.Position = Vector2.new(Camera.ViewportSize.X * 0.5, (Camera.ViewportSize.Y * 0.5) + FOV_Hitbox_Radius + FOV_Y_Offset + 25)
            WarningLabel.Text = "⚠️ ĐỊCH ĐANG Ở GẦN: " .. closestEnemyDistance .. " STUDS!"
            WarningLabel.Visible = true
        else
            WarningLabel.Visible = false
        end
    end)
end

